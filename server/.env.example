# Environment example for server

# OpenAI settings (for OpenAI.com)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# If using Azure OpenAI, set these instead:
# OPENAI_API_TYPE=azure
# OPENAI_API_BASE=https://your-resource.openai.azure.com
# OPENAI_DEPLOYMENT=your-deployment-name
# OPENAI_API_VERSION=2023-05-15

# GitHub token used by the server to create branches / PRs. Use a PAT or GitHub App installation token with repo permissions.
GITHUB_TOKEN=ghp_xxx_replace_with_secret
